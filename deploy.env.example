# Copy to deploy.env (or use the pre-filled deploy.env in this repo locally):
#   cp deploy.env.example deploy.env
#
# deploy.env is gitignored — do not commit SSH keys.

# --- SSH (same as: ssh -i "reloop.pem" ubuntu@ec2-3-104-43-187.ap-southeast-2.compute.amazonaws.com)
DEPLOY_USER=ubuntu
DEPLOY_HOST=ec2-3-104-43-187.ap-southeast-2.compute.amazonaws.com

# PEM key on your Mac (adjust if you move reloop.pem)
DEPLOY_SSH_KEY=$HOME/Downloads/reloop.pem

# Public URL (nginx / Certbot — not the EC2 hostname)
DEPLOY_URL=https://channels.reloop.pro

# --- Server layout (ubuntu@ip-172-31-18-155)
#   ~/reloop-backend/reloopsms-backend   Django + gunicorn socket
#   ~/reloop-sms                         Frontend git repo (optional; deploy uploads dist directly)
#   /var/www/dist                        Nginx root (channels.reloop.pro)
REMOTE_STAGING_DIR=/home/ubuntu/reloop-sms/dist
REMOTE_WWW_DIR=/var/www/dist

# Set to 1 to skip `npm run build` and upload an existing local dist/ folder
SKIP_BUILD=0
